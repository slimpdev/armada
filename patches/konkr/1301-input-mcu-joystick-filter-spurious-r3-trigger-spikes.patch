diff --git a/drivers/input/joystick/mcu_joystick.c b/drivers/input/joystick/mcu_joystick.c
--- a/drivers/input/joystick/mcu_joystick.c
+++ b/drivers/input/joystick/mcu_joystick.c
@@ -118,6 +118,20 @@
 #define MCU_AXIS_FLAT		128
 #define MCU_TRIG_MAX		255
 
+/*
+ * Some Pocket FIT Elite units occasionally emit very short false R3 presses
+ * and one-frame trigger spikes while the right Hall-effect stick is moving.
+ * Keep these tunable so the workaround can be adjusted per device.
+ */
+static unsigned int r3_debounce_ms = 50;
+module_param(r3_debounce_ms, uint, 0644);
+MODULE_PARM_DESC(r3_debounce_ms,
+		 "Minimum R3 press duration in ms before reporting it (0 disables)");
+
+static unsigned int trigger_confirm_frames = 2;
+module_param(trigger_confirm_frames, uint, 0644);
+MODULE_PARM_DESC(trigger_confirm_frames,
+		 "Consecutive non-zero trigger frames required before reporting (1 disables)");
+
 #define MCU_POLL_MS		16	/* ~60 Hz fallback poll (only when the IRQ is quiet) */
 #define MCU_IRQ_OK_MS		50	/* if the IRQ delivered a frame within this
 					 * window it is healthy; the fallback poll
@@ -176,6 +190,11 @@ struct mcu_joystick {
 	unsigned int bad_frames;
 	unsigned int reinit_fails;
 	bool dead;
+	unsigned int trig_left_nonzero_frames;
+	unsigned int trig_right_nonzero_frames;
+	bool r3_raw_down;
+	bool r3_reported_down;
+	unsigned long r3_down_since;
 };
 
 /*
@@ -350,13 +369,59 @@ static void mcu_power_dance(struct mcu_joystick *mcu)
 	msleep(600);
 }
 
+/*
+ * Suppress a trigger that is non-zero for only one MCU frame. This only
+ * delays activation: once confirmed, the raw analog value is passed through
+ * unchanged. A return to zero is always reported immediately.
+ */
+static u8 mcu_filter_trigger(u8 raw, unsigned int *nonzero_frames)
+{
+	unsigned int required = READ_ONCE(trigger_confirm_frames);
+
+	if (!raw) {
+		*nonzero_frames = 0;
+		return 0;
+	}
+
+	if (required <= 1)
+		return raw;
+
+	if (*nonzero_frames < required)
+		(*nonzero_frames)++;
+
+	if (*nonzero_frames < required)
+		return 0;
+
+	return raw;
+}
+
+/*
+ * R3 is a digital bit in the MCU key bitmap. Do not expose it until the raw
+ * bit has stayed asserted for the configured interval. Short pulses then
+ * disappear completely instead of becoming clicks in userspace.
+ */
+static void mcu_report_r3(struct mcu_joystick *mcu, bool down)
+{
+	unsigned int debounce = READ_ONCE(r3_debounce_ms);
+
+	if (!down) {
+		mcu->r3_raw_down = false;
+		if (mcu->r3_reported_down)
+			input_report_key(mcu->input, BTN_THUMBR, 0);
+		mcu->r3_reported_down = false;
+		return;
+	}
+
+	if (!mcu->r3_raw_down) {
+		mcu->r3_raw_down = true;
+		mcu->r3_down_since = jiffies;
+	}
+
+	if (!mcu->r3_reported_down &&
+	    (!debounce ||
+	     time_after_eq(jiffies, mcu->r3_down_since +
+				      msecs_to_jiffies(debounce)))) {
+		input_report_key(mcu->input, BTN_THUMBR, 1);
+		mcu->r3_reported_down = true;
+	}
+}
+
 static void mcu_report(struct mcu_joystick *mcu, const u16 regs[MCU_NREGS])
 {
 	struct input_dev *in = mcu->input;
 	u16 key = regs[MCU_FRAME_KEY];
+	u8 left_trigger, right_trigger;
 	int i;
 
 	/* stock: X/RX as-is, Y/RY bitwise-inverted (mvn + sxth) */
@@ -365,15 +430,22 @@ static void mcu_report(struct mcu_joystick *mcu, const u16 regs[MCU_NREGS])
 	input_report_abs(in, ABS_RY, (s16)~regs[MCU_FRAME_RZ]);
 	/* trigger reg: low byte = left (ABS_Z), high byte = right (ABS_RZ);
 	 * stock also reports digital TL2/TR2 at full deflection */
-	input_report_abs(in, ABS_Z,  regs[MCU_FRAME_TRIG] & 0xff);
-	input_report_abs(in, ABS_RZ, regs[MCU_FRAME_TRIG] >> 8);
-	input_report_key(in, BTN_TL2, (regs[MCU_FRAME_TRIG] & 0xff) == 0xff);
-	input_report_key(in, BTN_TR2, (regs[MCU_FRAME_TRIG] >> 8) == 0xff);
+	left_trigger = mcu_filter_trigger(regs[MCU_FRAME_TRIG] & 0xff,
+					 &mcu->trig_left_nonzero_frames);
+	right_trigger = mcu_filter_trigger(regs[MCU_FRAME_TRIG] >> 8,
+					  &mcu->trig_right_nonzero_frames);
+	input_report_abs(in, ABS_Z, left_trigger);
+	input_report_abs(in, ABS_RZ, right_trigger);
+	input_report_key(in, BTN_TL2, left_trigger == 0xff);
+	input_report_key(in, BTN_TR2, right_trigger == 0xff);
 
-	for (i = 0; i < ARRAY_SIZE(mcu_btn_map); i++)
+	for (i = 0; i < ARRAY_SIZE(mcu_btn_map); i++) {
+		if (mcu_btn_map[i].code == BTN_THUMBR)
+			continue;
 		input_report_key(in, mcu_btn_map[i].code,
 				 !!(key & BIT(mcu_btn_map[i].bit)));
+	}
+
+	mcu_report_r3(mcu, !!(key & BIT(11)));
 
 	input_report_abs(in, ABS_HAT0X,
 			 !!(key & MCU_DPAD_RIGHT) - !!(key & MCU_DPAD_LEFT));
@@ -401,6 +473,11 @@ static void mcu_report_idle(struct mcu_joystick *mcu)
 	for (i = 0; i < ARRAY_SIZE(mcu_btn_map); i++)
 		input_report_key(in, mcu_btn_map[i].code, 0);
 	input_sync(in);
+
+	mcu->trig_left_nonzero_frames = 0;
+	mcu->trig_right_nonzero_frames = 0;
+	mcu->r3_raw_down = false;
+	mcu->r3_reported_down = false;
 }
 
